# Environment variables for Render (shared PostgreSQL: food_mood_journal)

PORT=8080
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/food_mood_journal?sslmode=require
SPRING_DATASOURCE_USERNAME=your_render_pg_user
SPRING_DATASOURCE_PASSWORD=your_render_pg_password
INSIGHTS_SERVICE_URL=https://food-mood-insights-xxxx.onrender.com
